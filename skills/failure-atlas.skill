# 失败诊断图谱 (Failure Atlas)
# 系统性诊断和修复视频生成失败

name: "failure-atlas"
version: "1.0"
description: "失败诊断图谱，系统性诊断和修复视频生成失败"

# 核心理念
philosophy: |
  不要让用户盲目重试，要系统性诊断问题。
  
  失败原因图谱：
  1. 镜头问题 (Camera)
  2. 光影问题 (Lighting)
  3. 运动问题 (Motion)
  4. 参考角色问题 (Reference Role)
  5. 时长问题 (Duration)
  6. 构图问题 (Framing)
  7. 音频问题 (Audio)
  8. 安全问题 (Safety)

# 失败原因图谱
failure_atlas:
  # 镜头问题
  camera_issues:
    - problem: "镜头模糊"
      symptoms: ["画面模糊", "不清晰", "失焦"]
      causes: ["提示词中没有明确焦点", "景深设置不当"]
      solutions:
        - "明确指定焦点：'焦点在主体面部'"
        - "使用浅景深：'浅景深，背景虚化'"
        - "避免快速运动：'缓慢推进'"
    
    - problem: "镜头抖动"
      symptoms: ["画面晃动", "不稳定", "抖动"]
      causes: ["手持拍摄", "运动过快"]
      solutions:
        - "使用稳定器：'稳定器跟拍'"
        - "减少运动幅度：'缓慢移动'"
        - "使用固定镜头：'固定机位'"
    
    - problem: "镜头角度不当"
      symptoms: ["角度奇怪", "视角不适", "构图不佳"]
      causes: ["角度描述不明确", "角度选择不当"]
      solutions:
        - "明确角度：'眼平角度'、'低角度'、'高角度'"
        - "选择合适角度：根据意图选择"
        - "避免极端角度：'避免极端俯仰'"
  
  # 光影问题
  lighting_issues:
    - problem: "过曝"
      symptoms: ["画面太亮", "细节丢失", "高光溢出"]
      causes: ["光线太强", "没有阴影"]
      solutions:
        - "降低光线强度：'柔和的光线'"
        - "增加阴影：'侧光，营造层次'"
        - "使用自然光：'自然光，避免过曝'"
    
    - problem: "欠曝"
      symptoms: ["画面太暗", "细节不清", "阴影太深"]
      causes: ["光线不足", "阴影太重"]
      solutions:
        - "增加光线：'明亮的光线'"
        - "减少阴影：'正面光，减少阴影'"
        - "使用补光：'补光，提亮暗部'"
    
    - problem: "光影不自然"
      symptoms: ["光影奇怪", "不真实", "违和感"]
      causes: ["光影描述不具体", "光影矛盾"]
      solutions:
        - "使用具体光源：'窗外的自然光'"
        - "避免矛盾描述：'不要同时使用逆光和正面光'"
        - "参考真实场景：'参考真实场景的光影'"
  
  # 运动问题
  motion_issues:
    - problem: "动作不自然"
      symptoms: ["动作僵硬", "不流畅", "奇怪"]
      causes: ["动作描述不具体", "动作矛盾"]
      solutions:
        - "使用具体动词：'缓慢转身'而非'移动'"
        - "避免矛盾动作：'不要同时向前和向后'"
        - "参考真实动作：'参考真实的人体动作'"
    
    - problem: "运动过快"
      symptoms: ["运动太快", "看不清", "眩晕"]
      causes: ["运动速度描述不当"]
      solutions:
        - "降低速度：'缓慢移动'"
        - "使用慢动作：'慢动作'"
        - "减少运动幅度：'小幅移动'"
    
    - problem: "运动不连贯"
      symptoms: ["动作跳跃", "不连贯", "突变"]
      causes: ["动作描述不连续", "缺少过渡"]
      solutions:
        - "描述连续动作：'从A到B的连续动作'"
        - "添加过渡：'缓慢过渡'"
        - "避免突变：'避免突然变化'"
  
  # 参考角色问题
  reference_role_issues:
    - problem: "角色变形"
      symptoms: ["面部变形", "身体变形", "比例失调"]
      causes: ["参考图质量差", "描述不具体"]
      solutions:
        - "使用高质量参考图：'清晰的正面照'"
        - "明确描述：'保持面部特征不变'"
        - "减少运动：'减少面部区域的运动'"
    
    - problem: "角色不一致"
      symptoms: ["角色变化", "不连贯", "换人"]
      causes: ["缺少参考图", "描述不一致"]
      solutions:
        - "使用参考图：'@image1 角色参考'"
        - "保持描述一致：'使用相同的描述'"
        - "减少变化：'保持角色特征不变'"
    
    - problem: "角色识别度低"
      symptoms: ["看不清", "模糊", "不明确"]
      causes: ["参考图不清晰", "描述太模糊"]
      solutions:
        - "使用清晰参考图：'高分辨率的参考图'"
        - "明确特征：'红色头发，蓝色眼睛'"
        - "减少遮挡：'面部无遮挡'"
  
  # 时长问题
  duration_issues:
    - problem: "视频太短"
      symptoms: ["内容不完整", "仓促", "未完成"]
      causes: ["时长设置太短", "内容太多"]
      solutions:
        - "增加时长：'15秒'"
        - "减少内容：'简化内容'"
        - "分段制作：'分多集制作'"
    
    - problem: "视频太长"
      symptoms: ["拖沓", "冗长", "无聊"]
      causes: ["时长设置太长", "内容太少"]
      solutions:
        - "减少时长：'10秒'"
        - "增加内容：'丰富内容'"
        - "加快节奏：'加快节奏'"
    
    - problem: "节奏不当"
      symptoms: ["节奏太快", "节奏太慢", "不协调"]
      causes: ["节奏描述不当"]
      solutions:
        - "明确节奏：'缓慢的节奏'"
        - "匹配内容：'节奏与内容匹配'"
        - "参考示例：'参考类似视频的节奏'"
  
  # 构图问题
  framing_issues:
    - problem: "构图不佳"
      symptoms: ["构图奇怪", "不平衡", "不美观"]
      causes: ["构图描述不具体"]
      solutions:
        - "明确构图：'三分法构图'"
        - "使用引导线：'使用引导线'"
        - "避免杂乱：'简洁的构图'"
    
    - problem: "主体不突出"
      symptoms: ["主体不明显", "被淹没", "不突出"]
      causes: ["主体描述不明确", "背景太复杂"]
      solutions:
        - "明确主体：'主体在画面中心'"
        - "简化背景：'简洁的背景'"
        - "使用对比：'主体与背景形成对比'"
    
    - problem: "画面杂乱"
      symptoms: ["画面混乱", "元素太多", "不清晰"]
      causes: ["元素太多", "描述太复杂"]
      solutions:
        - "减少元素：'简化画面'"
        - "明确重点：'突出重点'"
        - "使用留白：'留白，保持简洁'"
  
  # 音频问题
  audio_issues:
    - problem: "声音不匹配"
      symptoms: ["声音与画面不匹配", "违和感"]
      causes: ["声音描述不当"]
      solutions:
        - "匹配画面：'声音与画面匹配'"
        - "使用环境音：'使用真实的环境音'"
        - "避免冲突：'避免声音与画面冲突'"
    
    - problem: "声音缺失"
      symptoms: ["没有声音", "静音"]
      causes: ["没有描述声音", "声音被忽略"]
      solutions:
        - "添加声音：'添加声音描述'"
        - "使用环境音：'使用环境音'"
        - "参考示例：'参考类似视频的声音'"
    
    - problem: "声音质量差"
      symptoms: ["声音模糊", "噪音", "不清晰"]
      causes: ["声音描述不具体"]
      solutions:
        - "明确声音：'清晰的人声'"
        - "减少噪音：'减少背景噪音'"
        - "使用高质量音频：'使用高质量音频'"
  
  # 安全问题
  safety_issues:
    - problem: "敏感词触发"
      symptoms: ["生成失败", "被屏蔽"]
      causes: ["包含敏感词"]
      solutions:
        - "替换敏感词：'用同义词替换'"
        - "避免敏感内容：'避免敏感话题'"
        - "使用安全表达：'使用安全的表达方式'"
    
    - problem: "版权问题"
      symptoms: ["版权警告", "被下架"]
      causes: ["使用受版权保护的内容"]
      solutions:
        - "使用原创内容：'使用原创内容'"
        - "避免版权内容：'避免使用受版权保护的内容'"
        - "使用安全素材：'使用安全的素材'"
    
    - problem: "内容不当"
      symptoms: ["内容被标记", "被限制"]
      causes: ["内容不当"]
      solutions:
        - "检查内容：'检查内容是否合适'"
        - "避免不当内容：'避免不当内容'"
        - "使用安全内容：'使用安全的内容'"

# 诊断流程
diagnosis_workflow:
  step_1: "识别问题类型"
    description: "根据用户描述，识别问题属于哪个类别"
    categories: ["镜头", "光影", "运动", "参考角色", "时长", "构图", "音频", "安全"]
  
  step_2: "分析具体原因"
    description: "在该类别下，分析具体原因"
    method: "查看症状，匹配原因"
  
  step_3: "提供解决方案"
    description: "根据原因，提供具体的解决方案"
    format: "问题 → 原因 → 解决方案"
  
  step_4: "验证解决"
    description: "验证解决方案是否有效"
    method: "重新生成，检查效果"

# 使用示例
usage_examples:
  # 示例 1：镜头模糊
  example_1:
    user_input: "生成的视频画面模糊"
    diagnosis:
      problem_type: "镜头问题"
      specific_problem: "镜头模糊"
      symptoms: ["画面模糊", "不清晰"]
      causes: ["提示词中没有明确焦点"]
      solutions:
        - "明确指定焦点：'焦点在主体面部'"
        - "使用浅景深：'浅景深，背景虚化'"
    fixed_prompt: |
      中景，眼平角度；焦点在主体面部；
      浅景深，背景虚化；
      缓慢推进；
      自然光，柔和的侧光。
  
  # 示例 2：角色变形
  example_2:
    user_input: "生成的视频角色面部变形"
    diagnosis:
      problem_type: "参考角色问题"
      specific_problem: "角色变形"
      symptoms: ["面部变形", "比例失调"]
      causes: ["参考图质量差", "描述不具体"]
      solutions:
        - "使用高质量参考图：'清晰的正面照'"
        - "明确描述：'保持面部特征不变'"
        - "减少运动：'减少面部区域的运动'"
    fixed_prompt: |
      中景，眼平角度；
      保持面部特征不变；
      缓慢移动，减少面部区域的运动；
      自然光，柔和的侧光；
      【参考】@image1 清晰的正面照
  
  # 示例 3：动作不自然
  example_3:
    user_input: "生成的视频动作不自然"
    diagnosis:
      problem_type: "运动问题"
      specific_problem: "动作不自然"
      symptoms: ["动作僵硬", "不流畅"]
      causes: ["动作描述不具体"]
      solutions:
        - "使用具体动词：'缓慢转身'而非'移动'"
        - "避免矛盾动作：'不要同时向前和向后'"
        - "参考真实动作：'参考真实的人体动作'"
    fixed_prompt: |
      中景，眼平角度；
      缓慢转身，自然流畅；
      避免僵硬，参考真实的人体动作；
      自然光，柔和的侧光。

# 快速诊断表
quick_diagnosis:
  - symptom: "画面模糊"
    likely_cause: "焦点不明确"
    quick_fix: "明确指定焦点"
  
  - symptom: "画面太亮"
    likely_cause: "过曝"
    quick_fix: "降低光线强度"
  
  - symptom: "画面太暗"
    likely_cause: "欠曝"
    quick_fix: "增加光线"
  
  - symptom: "动作僵硬"
    likely_cause: "描述不具体"
    quick_fix: "使用具体动词"
  
  - symptom: "角色变形"
    likely_cause: "参考图质量差"
    quick_fix: "使用高质量参考图"
  
  - symptom: "视频太短"
    likely_cause: "时长设置太短"
    quick_fix: "增加时长"
  
  - symptom: "构图奇怪"
    likely_cause: "构图描述不具体"
    quick_fix: "明确构图方式"
  
  - symptom: "声音不匹配"
    likely_cause: "声音描述不当"
    quick_fix: "匹配画面与声音"
  
  - symptom: "生成失败"
    likely_cause: "敏感词触发"
    quick_fix: "替换敏感词"

# 约束条件
constraints:
  - "必须系统性诊断问题"
  - "必须提供具体的解决方案"
  - "必须验证解决方案是否有效"
  - "必须支持快速诊断"
  - "必须覆盖所有常见问题"
