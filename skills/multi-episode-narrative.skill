# 尾帧衔接与多集连续叙事
# 解决从"单镜头"到"多集连续剧"的工程化问题

name: "multi-episode-narrative"
version: "1.0.0"
description: "尾帧衔接与多集连续叙事系统，实现无缝过渡的多集视频制作"

# 核心理念
philosophy: |
  从"单镜头"到"多集连续剧"的工程化解决方案。
  
  核心机制：
  1. 尾帧衔接：每集结尾记录最后一帧画面描述
  2. 视频延长：用"将@视频1延长15s"实现无缝过渡
  3. 四幕结构：起承转合 → 自动拆分为多集

# 尾帧衔接机制
tail_frame_mechanism:
  # 尾帧描述规范
  tail_frame_description:
    purpose: "记录本集最后一帧画面，用于下一集衔接"
    format: |
      本集尾帧描述：
      [画面内容]，[情感状态]，[悬念设置]
    
    example: |
      本集尾帧描述：
      主角转身离去，背影消失在夕阳中，留下一个悬念。
  
  # 尾帧设计原则
  tail_frame_design_principles:
    - principle: "情感延续"
      description: "下一集开头延续上一集的情感状态"
      example: "上一集结尾悲伤 → 下一集开头延续悲伤"
    
    - principle: "悬念设置"
      description: "为下一集留下悬念"
      example: "主角发现了一个秘密，但没有揭示"
    
    - principle: "视觉延续"
      description: "下一集开头的视觉元素与上一集结尾呼应"
      example: "上一集结尾的夕阳 → 下一集开头的朝阳"
    
    - principle: "动作延续"
      description: "下一集开头的动作与上一集结尾衔接"
      example: "上一集结尾转身 → 下一集开头继续转身"

# 视频延长语法
video_extension_syntax:
  # 基本语法
  basic_syntax: "将@视频1延长15s"
  
  # 完整示例
  complete_example: |
    将@视频1延长15s
    
    水墨武侠风格，9:16竖屏，灰白墨黑色调
    
    0-3秒画面：承接上一集结尾，主角转身
    3-6秒画面：新的场景建立，敌人出现
    6-9秒画面：战斗开始
    9-12秒画面：高潮对决
    12-15秒画面：悬念结尾，下一集预告
    
    【声音】延续上一集配乐风格
    【参考】@视频1 上一集视频
  
  # 延长注意事项
  extension_notes:
    - "必须在提示词开头添加延长语法"
    - "必须引用上一集视频作为参考"
    - "必须延续上一集的风格和色调"
    - "必须延续上一集的配乐风格"

# 四幕结构
four_act_structure:
  # 结构定义
  structure:
    act_1:
      name: "起（Setup）"
      purpose: "建立世界观、角色、冲突"
      episodes: "第 1-2 集"
      content:
        - "建立世界观"
        - "引入主要角色"
        - "设置核心冲突"
        - "建立情感基调"
    
    act_2:
      name: "承（Confrontation）"
      purpose: "发展冲突、增加复杂度"
      episodes: "第 3-4 集"
      content:
        - "发展核心冲突"
        - "增加复杂度"
        - "引入次要冲突"
        - "深化角色关系"
    
    act_3:
      name: "转（Climax）"
      purpose: "冲突达到顶点"
      episodes: "第 5-6 集"
      content:
        - "冲突达到顶点"
        - "情感爆发"
        - "关键转折"
        - "高潮时刻"
    
    act_4:
      name: "合（Resolution）"
      purpose: "解决冲突、收束故事"
      episodes: "第 7-8 集"
      content:
        - "解决核心冲突"
        - "收束故事线"
        - "情感升华"
        - "留下余韵"
  
  # 四幕结构示例
  example:
    title: "林冲风雪山神庙"
    act_1:
      episode_1: "林冲被陷害，发配沧州"
      episode_2: "林冲到达沧州，接管草料场"
    
    act_2:
      episode_3: "林冲发现阴谋，开始怀疑"
      episode_4: "林冲确认阴谋，准备反击"
    
    act_3:
      episode_5: "林冲与敌人对峙，战斗开始"
      episode_6: "林冲战胜敌人，揭露真相"
    
    act_4:
      episode_7: "林冲处理后果，情感升华"
      episode_8: "林冲离开，留下传奇"

# 多集连续叙事工作流
multi_episode_workflow:
  # 工作流程
  workflow:
    step_1:
      name: "创作剧本"
      description: "将故事改编为四幕结构剧本"
      output: "完整剧本"
    
    step_2:
      name: "拆分集数"
      description: "将剧本拆分为 8 集"
      output: "各集大纲"
    
    step_3:
      name: "设计素材"
      description: "为每个角色、场景、道具设计素材"
      output: "素材清单"
    
    step_4:
      name: "生成分镜"
      description: "为每集生成时间轴格式分镜"
      output: "各集分镜脚本"
    
    step_5:
      name: "生成视频"
      description: "使用 Seedance 2.0 生成视频"
      output: "各集视频"
    
    step_6:
      name: "视频延长"
      description: "从第二集开始，使用视频延长功能"
      output: "连续视频"
  
  # 工作流示例
  workflow_example: |
    1. 创作剧本：
       将《林冲风雪山神庙》改编为四幕结构剧本
    
    2. 拆分集数：
       第一幕：第 1-2 集（林冲被陷害，到达沧州）
       第二幕：第 3-4 集（发现阴谋，准备反击）
       第三幕：第 5-6 集（战斗，揭露真相）
       第四幕：第 7-8 集（处理后果，离开）
    
    3. 设计素材：
       C01 林冲·正面全身
       C02 林冲·侧面半身
       S01 沧州草料场·雪景
       P01 长枪
    
    4. 生成分镜：
       第一集分镜：
       水墨武侠风格，9:16竖屏，灰白墨黑色调
       0-3秒画面：远景，沧州草料场，大雪纷飞
       3-6秒画面：林冲出场，背光剪影
       6-9秒画面：林冲接管草料场
       9-12秒画面：林冲发现异常
       12-15秒画面：林冲警惕，悬念结尾
       【声音】古筝配乐 + 风声 + 脚步声
       【参考】@image1 林冲参考，@image2 草料场参考
    
    5. 生成视频：
       使用 Seedance 2.0 生成第一集视频
    
    6. 视频延长：
       第二集：
       将@视频1延长15s
       水墨武侠风格，9:16竖屏，灰白墨黑色调
       0-3秒画面：承接上一集结尾，林冲警惕
       3-6秒画面：敌人出现
       6-9秒画面：对峙开始
       9-12秒画面：战斗爆发
       12-15秒画面：悬念结尾
       【声音】延续上一集配乐风格
       【参考】@视频1 上一集视频

# 素材编号系统
material_numbering:
  # 角色素材
  character:
    prefix: "C"
    range: "C01-C99"
    description: "角色（多角度参考图）"
    angles:
      - "正面全身"
      - "侧面半身"
      - "背面全身"
      - "特写面部"
      - "动作姿态"
    example: "C01 林冲·正面全身"
  
  # 场景素材
  scene:
    prefix: "S"
    range: "S01-S99"
    description: "场景/地点"
    example: "S01 沧州草料场·雪景"
  
  # 道具素材
  prop:
    prefix: "P"
    range: "P01-P99"
    description: "道具/物品"
    example: "P01 长枪"

# 风格一致性策略
style_consistency:
  # 统一风格前缀
  style_prefix: |
    所有素材生成提示词必须以统一的风格前缀开头，例如：
    Chinese ink wash painting style mixed with anime cel-shading
  
  # 角色辨识度
  character_recognition:
    method: "通过不同的颜色方案和视觉标记区分角色"
    example: "主角穿红衣，配角穿蓝衣"
  
  # 多角度参考图
  multi_angle_reference:
    description: "为每个角色生成多张不同角度和状态的参考图"
    angles:
      - "正面全身"
      - "侧面半身"
      - "背面全身"
      - "特写面部"
      - "动作姿态"

# 使用示例
usage_examples:
  # 示例 1：单集视频
  single_episode:
    description: "生成单集视频"
    prompt: |
      水墨武侠风格，9:16竖屏，灰白墨黑色调
      
      0-3秒画面：远景，沧州草料场，大雪纷飞
      3-6秒画面：林冲出场，背光剪影
      6-9秒画面：林冲接管草料场
      9-12秒画面：林冲发现异常
      12-15秒画面：林冲警惕，悬念结尾
      
      【声音】古筝配乐 + 风声 + 脚步声
      【参考】@image1 林冲参考，@image2 草料场参考
  
  # 示例 2：多集连续
  multi_episode:
    description: "生成多集连续视频"
    workflow: |
      第一集：
      水墨武侠风格，9:16竖屏，灰白墨黑色调
      0-3秒画面：远景，沧州草料场，大雪纷飞
      3-6秒画面：林冲出场，背光剪影
      6-9秒画面：林冲接管草料场
      9-12秒画面：林冲发现异常
      12-15秒画面：林冲警惕，悬念结尾
      【声音】古筝配乐 + 风声 + 脚步声
      【参考】@image1 林冲参考，@image2 草料场参考
      
      第二集：
      将@视频1延长15s
      水墨武侠风格，9:16竖屏，灰白墨黑色调
      0-3秒画面：承接上一集结尾，林冲警惕
      3-6秒画面：敌人出现
      6-9秒画面：对峙开始
      9-12秒画面：战斗爆发
      12-15秒画面：悬念结尾
      【声音】延续上一集配乐风格
      【参考】@视频1 上一集视频

# 约束条件
constraints:
  - "每集结尾必须记录尾帧描述"
  - "从第二集开始必须使用视频延长语法"
  - "必须延续上一集的风格和色调"
  - "必须延续上一集的配乐风格"
  - "必须使用素材编号系统"
  - "必须保持风格一致性"
  - "必须遵循四幕结构"
