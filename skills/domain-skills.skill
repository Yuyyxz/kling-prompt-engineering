# 领域垂直 Skill 模板库
# 15 个行业专业 Skill，覆盖主流视频类型

name: "domain-skills"
version: "1.0.0"
description: "15 个行业垂直 Skill 模板，每个领域都有专属的提示词结构和优化参数"
philosophy: |
  每个视频类型有自己的视觉语法和观众期待。
  通用提示词无法替代领域知识——电商要干净、恐怖要压迫、美食要触感。

# 技能分类
categories:
  # 创意风格
  creative_styles:
    - id: "01"
      name: "电影风格"
      description: "影视品质 — 戏剧性光影、镜头语言、景深、调色"
      keywords: ["电影级质感", "戏剧性光影", "镜头语言", "景深", "调色"]
    
    - id: "02"
      name: "3D CGI"
      description: "3D 渲染 — Pixar、虚幻引擎、照片级、等距"
      keywords: ["3D渲染", "Pixar风格", "虚幻引擎", "照片级", "等距"]
    
    - id: "03"
      name: "卡通动画"
      description: "2D 动画 — 赛璐璐、手绘、扁平矢量、水彩"
      keywords: ["2D动画", "赛璐璐", "手绘", "扁平矢量", "水彩"]
    
    - id: "04"
      name: "漫画转视频"
      description: "动态漫画 — 漫画、条漫、分镜、连续画面"
      keywords: ["动态漫画", "漫画风格", "条漫", "分镜", "连续画面"]
    
    - id: "05"
      name: "打斗场景"
      description: "动作 — 武术、剑战、追逐、超级英雄"
      keywords: ["动作场景", "武术", "剑战", "追逐", "超级英雄"]
    
    - id: "06"
      name: "动漫"
      description: "日本动漫 — 少年、青年、机甲、日常、OP"
      keywords: ["日本动漫", "少年动漫", "青年动漫", "机甲", "日常"]
  
  # 商业营销
  commercial_marketing:
    - id: "07"
      name: "动态设计广告"
      description: "软件/SaaS — 产品发布、功能展示"
      keywords: ["动态设计", "软件广告", "SaaS", "产品发布", "功能展示"]
    
    - id: "08"
      name: "电商广告"
      description: "产品广告 — 时尚、美妆、电子、食品"
      keywords: ["电商广告", "产品广告", "时尚", "美妆", "电子", "食品"]
    
    - id: "09"
      name: "产品 360°"
      description: "转盘展示 — 多角度、主视觉、材质"
      keywords: ["产品展示", "360度", "转盘", "多角度", "材质"]
    
    - id: "10"
      name: "社交钩子"
      description: "病毒内容 — 抖音/TikTok/Reels/Shorts"
      keywords: ["社交媒体", "病毒内容", "抖音", "TikTok", "Reels", "Shorts"]
    
    - id: "11"
      name: "品牌故事"
      description: "品牌叙事 — 创业故事、使命、企业文化"
      keywords: ["品牌故事", "品牌叙事", "创业故事", "使命", "企业文化"]
  
  # 行业专项
  industry_specific:
    - id: "12"
      name: "音乐视频"
      description: "节拍同步 — 表演、叙事、可视化"
      keywords: ["音乐视频", "MV", "节拍同步", "表演", "叙事"]
    
    - id: "13"
      name: "时尚型录"
      description: "时尚 — 型录、走秀、穿搭、品牌活动"
      keywords: ["时尚", "型录", "走秀", "穿搭", "品牌活动"]
    
    - id: "14"
      name: "美食饮品"
      description: "美食 — 餐厅、食谱、ASMR、食欲诱惑"
      keywords: ["美食", "餐厅", "食谱", "ASMR", "食欲诱惑"]
    
    - id: "15"
      name: "房地产"
      description: "房产 — 房屋参观、建筑、室内设计"
      keywords: ["房地产", "房屋参观", "建筑", "室内设计"]

# 每个 Skill 的标准内部结构
skill_structure:
  # 2 秒钩子框架
  hook_framework:
    description: "前 2 秒必须抓住观众注意力"
    patterns: 12
  
  # 时间线分段
  timeline_segmentation:
    description: "逐拍分解，最长 15 秒"
    segments: 5
  
  # 摄像机运动百科
  camera_movement:
    description: "15-20+ 技术及精确措辞"
    techniques: 20
  
  # 灯光与氛围
  lighting_atmosphere:
    description: "传达情绪和品质的布光方案"
    setups: 10
  
  # 声音设计
  sound_design:
    description: "环境音、拟音、音乐、静默"
    types: 5
  
  # 素材引用策略
  reference_strategy:
    description: "@image1 @video1 @audio1 的最佳用法"
    syntax: "@[type][number]"
  
  # 平台优化
  platform_optimization:
    description: "抖音、TikTok、Instagram、YouTube 等"
    platforms: 5
  
  # 大型示例提示词
  example_prompts:
    description: "每个 15-25 行，制作级品质"
    count: 5

# 电影风格 Skill (01)
cinematic_skill:
  name: "电影风格"
  description: "影视品质 — 戏剧性光影、镜头语言、景深、调色"
  
  # 2 秒钩子
  hooks:
    - "悬念开场：展示一个未完成的动作"
    - "冲突开场：两个对立元素的碰撞"
    - "反转开场：预期与现实的对比"
    - "特写开场：极端近景展示细节"
    - "运动开场：快速移动吸引注意力"
  
  # 时间轴模板
  timeline_template: |
    电影风格，16:9横屏，电影色调
    
    0-3秒画面：远景建立，孤独的城堡在雾中若隐若现
    3-6秒画面：镜头推进，城堡大门缓缓打开
    6-9秒画面：主角出场，背光剪影，神秘感
    9-12秒画面：特写面部，眼神坚定
    12-15秒画面：主角转身走向城堡深处
    
    【声音】史诗配乐 + 风声 + 脚步声
    【参考】@image1 角色参考，@image2 场景参考
  
  # 运镜技术
  camera_techniques:
    - "推镜头：缓慢推进，营造紧张感"
    - "拉镜头：逐渐拉远，展示全貌"
    - "环绕镜头：360度旋转，强调重要性"
    - "希区柯克变焦：推拉镜头同时变焦，产生眩晕效果"
    - "一镜到底：全程无剪辑的连续镜头"
  
  # 光影方案
  lighting_setups:
    - "自然光：真实、自然"
    - "电影级光线：戏剧性、层次感"
    - "逆光：轮廓、神秘感"
    - "侧光：层次、立体感"
  
  # 声音设计
  sound_design:
    - "史诗配乐：宏大、震撼"
    - "环境音：风声、雨声、鸟鸣"
    - "音效：脚步声、门响、剑鸣"
    - "静默：关键时刻的静默"

# 电商广告 Skill (08)
ecommerce_skill:
  name: "电商广告"
  description: "产品广告 — 时尚、美妆、电子、食品"
  
  # 2 秒钩子
  hooks:
    - "问题开场：展示一个痛点"
    - "效果开场：展示惊人的效果"
    - "对比开场：使用前后的对比"
    - "限时开场：营造紧迫感"
    - "口碑开场：展示用户好评"
  
  # 时间轴模板
  timeline_template: |
    时尚电商风格，9:16竖屏，明亮色调
    
    0-3秒画面：2秒钩子，模特快速换装
    3-6秒画面：产品特写，材质细节
    6-9秒画面：使用场景，效果展示
    9-12秒画面：用户好评，社会证明
    12-15秒画面：促销信息，行动号召
    
    【声音】动感音乐 + 产品音效
    【参考】@image1 产品参考
  
  # 产品展示技巧
  product_showcase:
    - "特写镜头：展示产品细节"
    - "使用场景：展示产品在实际生活中的使用"
    - "效果对比：使用前后的对比"
    - "用户评价：展示真实用户的评价"
  
  # 促销技巧
  promotion_techniques:
    - "限时优惠：营造紧迫感"
    - "限量供应：制造稀缺感"
    - "用户好评：社会证明"
    - "行动号召：明确的购买指引"

# 动漫 Skill (06)
anime_skill:
  name: "动漫"
  description: "日本动漫 — 少年、青年、机甲、日常、OP"
  
  # 2 秒钩子
  hooks:
    - "技能开场：展示炫酷的技能"
    - "战斗开场：激烈的战斗场面"
    - "变身开场：角色变身过程"
    - "情感开场：强烈的情感表达"
    - "悬念开场：留下悬念"
  
  # 时间轴模板
  timeline_template: |
    日本动漫风格，16:9横屏，鲜艳色调
    
    0-3秒画面：角色出场，动态展示
    3-6秒画面：技能释放，特效展示
    6-9秒画面：战斗场面，动作流畅
    9-12秒画面：情感表达，内心独白
    12-15秒画面：悬念结尾，期待下一集
    
    【声音】动漫配乐 + 音效 + 声优配音
    【参考】@image1 角色参考
  
  # 动漫特色
  anime_features:
    - "夸张表情：情感表达夸张但真实"
    - "流畅动作：动作流畅自然"
    - "华丽特效：特效华丽但不杂乱"
    - "情感共鸣：情感表达深入人心"

# 知识口播 Skill
knowledge_avatar_skill:
  name: "知识口播"
  description: "知识分享 — 教程、讲解、科普"
  
  # 2 秒钩子
  hooks:
    - "问题开场：提出一个引人思考的问题"
    - "数据开场：展示惊人的数据"
    - "故事开场：讲述一个有趣的故事"
    - "悬念开场：留下悬念"
    - "价值开场：直接展示价值"
  
  # 时间轴模板
  timeline_template: |
    专业讲解风格，16:9横屏，明亮色调
    
    0-3秒画面：人物出场，建立镜头
    3-6秒画面：开始讲话，口型同步
    6-9秒画面：重点内容展示，图表弹出
    9-12秒画面：案例说明
    12-15秒画面：总结要点，引导关注
    
    【声音】清晰人声 + 轻柔背景音乐
    【参考】@image1 人物参考
  
  # 讲解技巧
  explanation_techniques:
    - "清晰表达：语速适中，吐字清晰"
    - "重点突出：关键信息用图表或动画展示"
    - "案例说明：用具体案例解释抽象概念"
    - "互动引导：引导观众思考或行动"

# 音乐视频 Skill (12)
music_video_skill:
  name: "音乐视频"
  description: "节拍同步 — 表演、叙事、可视化"
  
  # 2 秒钩子
  hooks:
    - "节奏开场：强烈的节奏感"
    - "视觉开场：震撼的视觉效果"
    - "情感开场：强烈的情感表达"
    - "悬念开场：留下悬念"
    - "表演开场：精彩的表演"
  
  # 时间轴模板
  timeline_template: |
    音乐视频风格，16:9横屏，艺术色调
    
    0-3秒画面：开场视觉，建立氛围
    3-6秒画面：歌手出场，表演开始
    6-9秒画面：副歌高潮，视觉爆发
    9-12秒画面：情感表达，故事穿插
    12-15秒画面：结尾落版，余韵延续
    
    【声音】音乐为主，画面配合节奏
    【参考】@image1 歌手参考，@audio1 音乐参考
  
  # 音乐视频特色
  music_video_features:
    - "节奏同步：画面与音乐节奏同步"
    - "视觉效果：配合歌曲情感的视觉效果"
    - "表演镜头：展示歌手的表演"
    - "叙事镜头：穿插故事线"

# 使用指南
usage_guide:
  # 如何选择 Skill
  selection_guide:
    - content_type: "电影、短剧"
      skill: "01 电影风格"
    
    - content_type: "产品广告"
      skill: "08 电商广告"
    
    - content_type: "动漫、二次元"
      skill: "06 动漫"
    
    - content_type: "知识分享"
      skill: "知识口播"
    
    - content_type: "音乐视频"
      skill: "12 音乐视频"
  
  # 使用流程
  workflow:
    step_1: "确定内容类型"
    step_2: "选择对应的 Skill"
    step_3: "使用导演引擎回答五问"
    step_4: "使用时间轴格式生成提示词"
    step_5: "根据 Skill 的特色进行优化"

# 约束条件
constraints:
  - "每个 Skill 必须包含 2 秒钩子框架"
  - "每个 Skill 必须使用时间轴格式"
  - "每个 Skill 必须包含 5+ 大型示例提示词"
  - "每个 Skill 必须包含平台优化建议"
  - "每个 Skill 必须包含声音设计"
  - "每个 Skill 必须包含素材引用策略"
