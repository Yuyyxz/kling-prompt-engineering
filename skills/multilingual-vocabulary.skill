# 多语言电影词汇表
# 6 种语言的原生电影词汇，不是翻译，是原生表达

name: "multilingual-vocabulary"
version: "1.0.0"
description: "多语言电影词汇表，支持 6 种语言的原生电影词汇"

# 核心理念
philosophy: |
  不是翻译，是原生表达。
  
  每种语言都有自己独特的电影表达方式。
  中文的"水墨武侠"不能翻译成"ink wash martial arts"，应该保留原生表达。

# 支持的语言
supported_languages:
  - code: "zh"
    name: "中文"
    description: "简体中文"
  
  - code: "en"
    name: "English"
    description: "英语"
  
  - code: "ja"
    name: "日本語"
    description: "日语"
  
  - code: "ko"
    name: "한국어"
    description: "韩语"
  
  - code: "es"
    name: "Español"
    description: "西班牙语"
  
  - code: "ru"
    name: "Русский"
    description: "俄语"

# 中文电影词汇
chinese_vocabulary:
  # 视觉风格
  visual_styles:
    - term: "水墨武侠"
      description: "中国传统的水墨画风格与武侠元素结合"
      keywords: ["水墨", "武侠", "江湖", "侠客"]
    
    - term: "国风动漫"
      description: "中国风格的动漫"
      keywords: ["国风", "古风", "仙侠", "玄幻"]
    
    - term: "赛博朋克"
      description: "未来科技与黑暗风格结合"
      keywords: ["赛博", "朋克", "霓虹", "未来"]
    
    - term: "复古胶片"
      description: "怀旧的胶片质感"
      keywords: ["复古", "胶片", "怀旧", "颗粒感"]
  
  # 镜头语言
  camera_language:
    - term: "远景"
      description: "展示环境，建立规模"
    
    - term: "中景"
      description: "展示人物上半身"
    
    - term: "近景"
      description: "聚焦面部"
    
    - term: "特写"
      description: "聚焦细节"
    
    - term: "推镜头"
      description: "镜头向前推进"
    
    - term: "拉镜头"
      description: "镜头向后拉远"
    
    - term: "环绕镜头"
      description: "镜头围绕主体旋转"
  
  # 光影描述
  lighting:
    - term: "自然光"
      description: "真实、自然的光线"
    
    - term: "电影级光线"
      description: "戏剧性、层次感的光线"
    
    - term: "逆光"
      description: "从主体背后照射的光线"
    
    - term: "侧光"
      description: "从侧面照射的光线"
  
  # 情感表达
  emotions:
    - term: "孤独"
      description: "独自一人，感到寂寞"
    
    - term: "坚定"
      description: "意志坚强，不动摇"
    
    - term: "温柔"
      description: "温和、体贴"
    
    - term: "愤怒"
      description: "强烈的不满和敌意"

