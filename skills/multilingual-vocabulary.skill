# 多语言翻译规则
translation_rules:
  # 保留原生表达
  preserve_native: |
    某些术语应该保留原生表达，不要翻译：
    - 中文：水墨武侠、国风动漫、江湖、侠客
    - 日语：アニメ、和風、侍、忍者
    - 韩语：한국 애니메이션、한류
    - 西班牙语：Cine Negro
    - 俄语：Фильм Нуар
  
  # 翻译映射
  translation_mapping:
    - source: "zh"
      target: "en"
      mappings:
        "水墨武侠": "Chinese Ink Wash Martial Arts"
        "国风动漫": "Chinese Style Anime"
        "赛博朋克": "Cyberpunk"
        "复古胶片": "Vintage Film"
    
    - source: "zh"
      target: "ja"
      mappings:
        "水墨武侠": "水墨武術"
        "国风动漫": "中国風アニメ"
        "赛博朋克": "サイバーパンク"
        "复古胶片": "ビンテージフィルム"

# 使用示例
usage_examples:
  # 示例 1：中文提示词
  example_chinese:
    language: "zh"
    prompt: |
      水墨武侠风格，9:16竖屏，灰白墨黑色调
      
      0-3秒画面：远景，广阔的江湖，大雪纷飞
      3-6秒画面：镜头推进，主角出场，背光剪影
      6-9秒画面：拔剑起舞，剑光闪烁
      9-12秒画面：与敌人对峙，剑拔弩张
      12-15秒画面：收剑入鞘，转身离去
      
      【声音】古筝配乐 + 风声 + 剑鸣
      【参考】@image1 角色参考，@image2 场景参考
  
  # 示例 2：英文提示词
  example_english:
    language: "en"
    prompt: |
      Chinese Ink Wash Martial Arts style, 9:16 vertical, gray and black tones
      
      0-3s: Wide shot, vast martial arts world, heavy snow
      3-6s: Push in, protagonist appears, backlight silhouette
      6-9s: Sword dance, sword light flickers
      9-12s: Confrontation with enemy, tension rises
      12-15s: Sheathe sword, turn and leave
      
      【Sound】Guqin music + wind + sword sounds
      【Reference】@image1 character reference, @image2 scene reference

# 约束条件
constraints:
  - "必须使用原生表达，不要翻译"
  - "必须支持 6 种语言"
  - "必须包含完整的词汇表"
  - "必须提供翻译映射"
  - "必须提供使用示例"
